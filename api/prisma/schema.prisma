generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id        Int     @id @default(autoincrement())
  name      String
  address   String?
  yearBuilt Int?

  ownerId String

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Room {
  id          Int     @id @default(autoincrement())
  name        String
  floor       String?
  description String?

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  entries Entry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model Entry {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  category    EntryCategory
  tags        String[]      @default([])

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  device Device?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([category])
}

model Attachment {
  id          Int            @id @default(autoincrement())
  fileName    String
  storagePath String         @unique
  mimeType    String
  size        Int
  kind        AttachmentKind @default(IMAGE)

  entryId Int
  entry   Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
}

model Device {
  id Int @id @default(autoincrement())

  entryId Int   @unique
  entry   Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  manufacturer String?
  model        String?
  serialNumber String?

  purchaseDate  DateTime?
  installedAt   DateTime?
  warrantyUntil DateTime?

  purchasePriceCents Int?

  contractorName String?

  serviceRecords ServiceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warrantyUntil])
  @@index([manufacturer])
  @@index([serialNumber])
}

model ServiceRecord {
  id Int @id @default(autoincrement())

  deviceId Int
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  type ServiceType

  serviceDate DateTime

  description String?

  contractorName String?

  costCents Int?

  nextServiceDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@index([serviceDate])
  @@index([nextServiceDate])
}

enum ServiceType {
  INSTALLATION
  INSPECTION
  REPAIR
  MAINTENANCE
  OTHER
}

enum EntryCategory {
  ELECTRICAL
  PLUMBING
  HEATING
  WALL
  FLOOR
  DEVICE
  NOTE
  OTHER
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}
